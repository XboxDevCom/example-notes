<Page
    x:Class="NotesApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NotesApp"
    xmlns:models="using:NotesApp.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseSystemFocusVisuals="True"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="48,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Notizen"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,0,0,12" />
                <Button x:Name="NewNoteButton"
                        Content="Neue Notiz"
                        Click="NewNoteButton_Click"
                        Margin="0,0,0,12"
                        MinHeight="48"
                        MinWidth="120"
                        XYFocusDown="NotesList" />
                <ListView x:Name="NotesList"
                          ItemClick="NotesList_ItemClick"
                          IsItemClickEnabled="True"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Note">
                            <StackPanel MinHeight="60"
                                        Padding="12,8"
                                        Margin="0,2">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                                           FontSize="14"
                                           Foreground="Gray"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           Margin="0,4,0,2" />
                                <TextBlock Text="{x:Bind ModifiedAt, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="Gray" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="60" />
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" Margin="12,0,0,0">
            <StackPanel x:Name="EditPanel"
                        Visibility="Collapsed">
                <TextBox x:Name="TitleBox"
                         Header="Titel"
                         FontSize="20"
                         MinWidth="300"
                         Margin="0,0,0,12" />
                <TextBox x:Name="ContentBox"
                         Header="Inhalt"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="200"
                         MinWidth="300"
                         Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SaveButton"
                            Content="Speichern"
                            Click="SaveButton_Click"
                            MinHeight="48"
                            MinWidth="120"
                            XYFocusRight="DeleteButton" />
                    <Button x:Name="DeleteButton"
                            Content="Löschen"
                            Click="DeleteButton_Click"
                            MinHeight="48"
                            MinWidth="120"
                            XYFocusLeft="SaveButton" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="EmptyState"
                       Text="Wähle eine Notiz aus oder erstelle eine neue."
                       FontSize="20"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
